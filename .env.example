# Enterprise AI Integration Platform - Environment Configuration
# Copy this file to .env and configure with your actual values

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# Anthropic Claude API (Primary AI Provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# OpenAI GPT API (Secondary AI Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_ORGANIZATION=your_org_id_optional

# Google Gemini API (Tertiary AI Provider)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro

# Local AI Configuration (Optional)
LOCAL_AI_ENABLED=false
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3:70b

# =============================================================================
# ERP SYSTEM INTEGRATION
# =============================================================================

# SAP ERP Integration
SAP_BASE_URL=https://your-sap-system.com
SAP_API_KEY=your_sap_api_key
SAP_USERNAME=your_sap_username
SAP_PASSWORD=your_sap_password
SAP_CLIENT_ID=your_sap_client_id
SAP_CLIENT_SECRET=your_sap_client_secret

# Oracle ERP Integration
ORACLE_BASE_URL=https://your-oracle-system.com
ORACLE_API_KEY=your_oracle_api_key
ORACLE_USERNAME=your_oracle_username
ORACLE_PASSWORD=your_oracle_password
ORACLE_DATABASE=your_oracle_database

# Microsoft Dynamics 365 Integration
DYNAMICS_CLIENT_ID=your_dynamics_client_id
DYNAMICS_CLIENT_SECRET=your_dynamics_client_secret
DYNAMICS_TENANT_ID=your_dynamics_tenant_id
DYNAMICS_BASE_URL=https://your-dynamics-instance.crm.dynamics.com

# NetSuite Integration (Future)
NETSUITE_ACCOUNT_ID=your_netsuite_account_id
NETSUITE_CONSUMER_KEY=your_netsuite_consumer_key
NETSUITE_CONSUMER_SECRET=your_netsuite_consumer_secret
NETSUITE_TOKEN_ID=your_netsuite_token_id
NETSUITE_TOKEN_SECRET=your_netsuite_token_secret

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=your_postgres_password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana Dashboard
GRAFANA_ENABLED=true
GRAFANA_PORT=3000

# Logging
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# =============================================================================
# PERFORMANCE AND SCALING
# =============================================================================

# Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Caching
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Registry
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest

# Container Resources
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=4G
CONTAINER_CPU_REQUEST=1
CONTAINER_MEMORY_REQUEST=2G

# =============================================================================
# KUBERNETES CONFIGURATION
# =============================================================================

# Kubernetes Namespace
K8S_NAMESPACE=enterprise-ai

# Replica Configuration
K8S_REPLICAS=3
K8S_MAX_REPLICAS=10

# Auto-scaling
K8S_HPA_ENABLED=true
K8S_HPA_CPU_THRESHOLD=70
K8S_HPA_MEMORY_THRESHOLD=80

# =============================================================================
# BUSINESS LOGIC CONFIGURATION
# =============================================================================

# AI Conversation Settings
MAX_CONVERSATION_LENGTH=50
CONVERSATION_TIMEOUT=300
AI_THINKING_DELAY=2

# Business Rules
MIN_PURCHASE_ORDER_AMOUNT=100
MAX_BULK_DISCOUNT_QUANTITY=1000
DEFAULT_SUPPLIER_RATING_THRESHOLD=4.0

# Compliance and Audit
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555
COMPLIANCE_MODE=strict

# =============================================================================
# EXTERNAL SERVICE INTEGRATION
# =============================================================================

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Slack Integration
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_CHANNEL=#ai-integrations

# Microsoft Teams Integration
TEAMS_WEBHOOK_URL=your_teams_webhook_url

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Test Configuration
TEST_MODE=false
MOCK_AI_RESPONSES=false
MOCK_ERP_RESPONSES=false

# Development Tools
HOT_RELOAD=true
AUTO_RELOAD=true
PROFILING_ENABLED=false

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_URL=/docs
API_DOCS_TITLE="Enterprise AI Integration API"
API_DOCS_DESCRIPTION="AI-to-AI communication platform for enterprise systems"

# =============================================================================
# COST OPTIMIZATION
# =============================================================================

# AI Provider Cost Tracking
COST_TRACKING_ENABLED=true
COST_ALERT_THRESHOLD=100
COST_ALERT_EMAIL=admin@yourcompany.com

# Resource Optimization
AUTO_SCALING_ENABLED=true
IDLE_TIMEOUT=300
RESOURCE_CLEANUP_INTERVAL=3600

# =============================================================================
# BACKUP AND DISASTER RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=24
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# Disaster Recovery
DR_ENABLED=false
DR_REGION=us-west-2
DR_RTO_MINUTES=60
DR_RPO_MINUTES=15

# =============================================================================
# NOTES AND INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual configuration
# 3. Never commit .env file to version control
# 4. Use strong, unique passwords for all services
# 5. Regularly rotate API keys and secrets
# 6. Test configuration with: ./verify-installation.sh
# 7. For production, use environment-specific configuration management

# Required for basic functionality:
# - At least one AI provider API key (ANTHROPIC_API_KEY recommended)
# - Database configuration (PostgreSQL and Redis)
# - Basic server configuration

# Optional for enhanced functionality:
# - Additional AI provider keys for failover
# - ERP system integration credentials
# - Monitoring and observability tools
# - External service integrations
# - Advanced scaling and performance settings
